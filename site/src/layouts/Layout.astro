---
import ThemeSwitcher from '@/components/ThemeSwitcher';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Automate the fetching, versioning, and Notion-sync of TLE data' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/tle-sync';

const navItems = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/data-explorer`, label: 'Data Explorer' },
  { href: `${base}/statistics`, label: 'Statistics' },
  { href: `${base}/discussions`, label: 'Discussions' },
  { href: `${base}/development-board`, label: 'Dev Board' },
  { href: `${base}/create-issue`, label: 'Create Issue' },
  { href: `${base}/docs`, label: 'Docs' },
  { href: `${base}/visualizer`, label: 'Visualizer' },
];

// Get commit SHA from environment (set by CI)
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA || 'dev';
const shortSha = commitSha.substring(0, 7);
const deployTime = import.meta.env.PUBLIC_DEPLOY_TIME || new Date().toISOString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | TLE Sync</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>

    <div class="min-h-screen flex flex-col">
      <!-- Navbar -->
      <header class="navbar bg-base-200 shadow-lg sticky top-0 z-40">
        <div class="navbar-start">
          <div class="dropdown">
            <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"
                ></path>
              </svg>
            </div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-200 rounded-box w-52"
            >
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={currentPath === item.href || currentPath === item.href + '/' ? 'active' : ''}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <a href={`${base}/`} class="btn btn-ghost text-xl normal-case">
            <span class="font-bold">TLE Sync</span>
          </a>
        </div>

        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={currentPath === item.href || currentPath === item.href + '/' ? 'active' : ''}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="navbar-end gap-2">
          <a
            href="https://github.com/cywf/tle-sync"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm btn-square"
            aria-label="View on GitHub"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <ThemeSwitcher client:load />
        </div>
      </header>

      <!-- Main Content -->
      <main id="main-content" class="flex-1 container mx-auto px-4 py-8">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="footer footer-center p-6 bg-base-200 text-base-content">
        <div class="grid grid-flow-col gap-4">
          <a
            href="https://github.com/cywf/tle-sync/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover"
          >
            MIT License
          </a>
          <span class="opacity-70">
            Deploy: {new Date(deployTime).toLocaleDateString()} @ <code class="text-xs">{shortSha}</code>
          </span>
        </div>
        <div>
          <p class="text-sm opacity-70">
            Built with <a href="https://astro.build" class="link" target="_blank">Astro</a>
            {' '}&amp; <a href="https://daisyui.com" class="link" target="_blank">daisyUI</a>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
