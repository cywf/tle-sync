---
import Layout from '@/layouts/Layout.astro';

const base = import.meta.env.BASE_URL || '/tle-sync';
---

<Layout title="404 - Page Not Found">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="text-9xl font-bold text-primary">404</div>
    
    <div>
      <h1 class="text-4xl font-bold mb-4">Page Not Found</h1>
      <p class="text-lg opacity-70 mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
    </div>

    <div class="flex gap-4 flex-wrap justify-center">
      <a href={`${base}/`} class="btn btn-primary">
        Go Home
      </a>
      <a href={`${base}/data-explorer`} class="btn btn-outline">
        Explore Data
      </a>
      <a href={`${base}/docs`} class="btn btn-outline">
        Read Docs
      </a>
    </div>

    <div class="divider">OR</div>

    <div class="card bg-base-200 shadow-xl max-w-md">
      <div class="card-body">
        <h2 class="card-title">Need Help?</h2>
        <p class="text-sm opacity-70">
          Check out our documentation or open an issue if you think this is a bug.
        </p>
        <div class="card-actions justify-end">
          <a
            href="https://github.com/cywf/tle-sync/issues/new"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-ghost"
          >
            Report Issue
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
