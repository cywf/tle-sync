---
import Layout from '@/layouts/Layout.astro';

const base = import.meta.env.BASE_URL || '/tle-sync';

let discussions: any[] = [];
let error: string | null = null;

try {
  const response = await fetch(`${Astro.url.origin}${base}/data/discussions.json`);
  if (response.ok) {
    discussions = await response.json();
  }
} catch (e) {
  error = 'Discussions data not available';
}
---

<Layout title="Discussions" description="Community discussions">
  <div class="space-y-6">
    <div>
      <h1 class="text-4xl font-bold mb-2">Discussions</h1>
      <p class="text-lg opacity-70">
        Browse community discussions about tle-sync.
      </p>
    </div>

    <div class="breadcrumbs text-sm">
      <ul>
        <li><a href={base}>Home</a></li>
        <li>Discussions</li>
      </ul>
    </div>

    <div class="flex justify-between items-center">
      <div class="text-sm opacity-70">
        Latest {discussions.length} discussions
      </div>
      <a
        href="https://github.com/cywf/tle-sync/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm"
      >
        View All on GitHub
      </a>
    </div>

    {error ? (
      <div class="alert alert-warning">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="font-bold">Discussions unavailable</h3>
          <p class="text-sm">Discussions will be available after the first CI build.</p>
        </div>
      </div>
    ) : discussions.length > 0 ? (
      <div class="space-y-4">
        {discussions.map((discussion) => (
          <div class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow">
            <div class="card-body">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="card-title text-lg">
                    <a
                      href={discussion.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link link-hover"
                    >
                      {discussion.title}
                    </a>
                  </h3>
                  {discussion.category && (
                    <div class="badge badge-primary badge-sm mt-2">
                      {discussion.category}
                    </div>
                  )}
                  <div class="text-sm opacity-70 mt-2">
                    by {discussion.author} • {new Date(discussion.createdAt).toLocaleDateString()}
                  </div>
                </div>
                <div class="flex gap-4 text-sm opacity-70">
                  {discussion.comments !== undefined && (
                    <div class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                      </svg>
                      <span>{discussion.comments}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="alert">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>No discussions found.</span>
      </div>
    )}
  </div>
</Layout>
