---
import Layout from '@/layouts/Layout.astro';
import { LanguagesChart, CommitChart } from '@/components/Charts';

const base = import.meta.env.BASE_URL || '/tle-sync';

// Load stats from public/data/stats.json (generated by CI)
let stats: any = null;
let error: string | null = null;

try {
  const response = await fetch(`${Astro.url.origin}${base}/data/stats.json`);
  if (response.ok) {
    stats = await response.json();
  }
} catch (e) {
  error = 'Stats data not available';
}
---

<Layout title="Statistics" description="Repository statistics and insights">
  <div class="space-y-6">
    <div>
      <h1 class="text-4xl font-bold mb-2">Repository Statistics</h1>
      <p class="text-lg opacity-70">
        Insights and metrics for the tle-sync repository.
      </p>
    </div>

    <div class="breadcrumbs text-sm">
      <ul>
        <li><a href={base}>Home</a></li>
        <li>Statistics</li>
      </ul>
    </div>

    {error ? (
      <div class="alert alert-warning">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="font-bold">Stats unavailable</h3>
          <p class="text-sm">Statistics will be available after the first CI build.</p>
        </div>
      </div>
    ) : stats ? (
      <div class="space-y-6">
        <!-- Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="stat bg-base-200 rounded-lg shadow-xl">
            <div class="stat-figure text-primary">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <div class="stat-title">Stars</div>
            <div class="stat-value">{stats.stars || 0}</div>
          </div>

          <div class="stat bg-base-200 rounded-lg shadow-xl">
            <div class="stat-figure text-secondary">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
            </div>
            <div class="stat-title">Forks</div>
            <div class="stat-value">{stats.forks || 0}</div>
          </div>

          <div class="stat bg-base-200 rounded-lg shadow-xl">
            <div class="stat-figure text-accent">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div class="stat-title">Watchers</div>
            <div class="stat-value">{stats.watchers || 0}</div>
          </div>
        </div>

        <!-- Language Breakdown -->
        {stats.languages && Object.keys(stats.languages).length > 0 && (
          <div class="card bg-base-200 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">Language Breakdown</h2>
              <div class="max-w-md mx-auto">
                <LanguagesChart data={stats.languages} client:load />
              </div>
            </div>
          </div>
        )}

        <!-- Commit Activity -->
        {stats.commits && stats.commits.length > 0 && (
          <div class="card bg-base-200 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">12-Week Commit Activity</h2>
              <CommitChart data={stats.commits} client:load />
            </div>
          </div>
        )}

        <!-- Additional Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {stats.open_issues !== undefined && (
            <div class="stat bg-base-200 rounded-lg shadow-xl">
              <div class="stat-title">Open Issues</div>
              <div class="stat-value text-warning">{stats.open_issues}</div>
            </div>
          )}

          {stats.default_branch && (
            <div class="stat bg-base-200 rounded-lg shadow-xl">
              <div class="stat-title">Default Branch</div>
              <div class="stat-value text-2xl">{stats.default_branch}</div>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="flex justify-center items-center min-h-[400px]">
        <span class="loading loading-spinner loading-lg"></span>
      </div>
    )}
  </div>
</Layout>
