---
import Layout from '@/layouts/Layout.astro';
import MermaidViewer from '@/components/MermaidViewer';

const base = import.meta.env.BASE_URL || '/tle-sync';

// Load diagrams from public/diagrams/
const diagrams: { name: string; content: string; path: string }[] = [];

// Fallback: sample diagram for demonstration
const fallbackDiagram = {
  name: 'TLE Sync Workflow',
  content: `graph LR
    A[GitHub Actions] --> B[Fetch TLE Data]
    B --> C[Update tle_data/]
    C --> D[Commit Changes]
    D --> E[Push to Repository]
    B --> F[Update Notion]
    F --> G[Sync Databases]`,
  path: '/diagrams/workflow.mmd'
};

diagrams.push(fallbackDiagram);
---

<Layout title="Visualizer" description="Project diagrams and visualizations">
  <div class="space-y-6">
    <div>
      <h1 class="text-4xl font-bold mb-2">Project Visualizer</h1>
      <p class="text-lg opacity-70">
        Explore project architecture and workflows through interactive diagrams.
      </p>
    </div>

    <div class="breadcrumbs text-sm">
      <ul>
        <li><a href={base}>Home</a></li>
        <li>Visualizer</li>
      </ul>
    </div>

    <MermaidViewer diagrams={diagrams} client:load />
  </div>
</Layout>
